{
  "name": "vaquero-hub",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write eslint.config.mjs eslint-rules package.json playwright.config.ts vitest.config.mts lib/supabase scripts tests .github",
    "format:check": "prettier --check eslint.config.mjs eslint-rules package.json playwright.config.ts vitest.config.mts lib/supabase scripts tests .github",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "jsbarcode": "3.12.3",
    "lucide-react": "0.542.0",
    "next": "16.2.6",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsbarcode": "3.11.4",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
