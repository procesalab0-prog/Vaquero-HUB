# Variables públicas: pueden llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variable secreta: sólo para procesos confiables del servidor.
# Nunca agregues NEXT_PUBLIC_ a este nombre.
SUPABASE_SECRET_KEY=

# Sólo para ejecutar una vez `pnpm bootstrap:admin` desde una terminal segura.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMPLOYEE_CODE=
ADMIN_FULL_NAME=
