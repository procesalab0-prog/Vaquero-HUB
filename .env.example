# Variables públicas: pueden llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variable secreta: sólo para procesos confiables del servidor.
# Nunca agregues NEXT_PUBLIC_ a este nombre.
SUPABASE_SECRET_KEY=

# Origen independiente de la PWA para clientes. No incluyen secretos.
# Ejemplo futuro: https://mi.vaquerosm.com y mi.vaquerosm.com
CUSTOMER_APP_URL=
CUSTOMER_APP_HOST=
# Activar sólo después de configurar y probar un proveedor SMS en Supabase Auth.
CUSTOMER_PHONE_OTP_ENABLED=false

# Sólo para ejecutar una vez `pnpm bootstrap:admin` desde una terminal segura.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMPLOYEE_CODE=
ADMIN_FULL_NAME=
